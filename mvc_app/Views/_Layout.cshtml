<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Manager</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    
    <style>
        body {
            background-color: #f8f9fa;
        }
        .navbar-nav .nav-link:hover {
            color: #0dcaf0 !important; 
        }
    </style>
</head>
<body>
    
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom shadow-sm mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-info" href="/Account/Welcome">User Manager</a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                    <ul class="navbar-nav">
                        @* Если пользователь вошел, показываем ссылки на Главную и Tools *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white px-3" href="/Home/Index">Главная</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning px-3 fw-bold" href="/Home/Tools">Tools</a>
                            </li>
                        }
                    </ul>

                    @* Правая часть: Приветствие и кнопки входа/выхода *@
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-info me-3 fw-semibold">Привет, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm px-3" href="/Account/Logout">Выйти</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white me-3 px-2" href="/Account/Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-info btn-sm text-dark fw-bold px-3" href="/Account/Register">Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 mt-5 bg-white">
        <div class="container">
            &copy; @DateTime.Now.Year - mvc_app - Менеджер пользователей
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>